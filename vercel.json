{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/index.js": {
      "includeFiles": "{dist/**,node_modules/@zxing/browser/umd/zxing-browser.min.js}"
    }
  },
  "routes": [
    {
      "src": "^/(.*)$",
      "dest": "/api/index?__radius_path=/$1"
    }
  ]
}
